# Copy to .env.ai.local (ignored by Git). Never put credentials in .env.dev.
OPENAI_API_KEY=
# Set a model enabled in your OpenAI project with Structured Outputs support.
OPENAI_MODEL=gpt-6-luna
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_OUTPUT_TOKENS=12000
OPENAI_REASONING_EFFORT=low
# Administrators can choose per-attempt budgets in Operational failures.
